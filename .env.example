# LLM mode and settings
LLM_MODE=scripted
GEMINI_API_KEY=dummy-gemini-key
GEMINI_MODEL=gemini-3.8-flash

# Search backend (fixture or ddgs)
SEARCH_BACKEND=fixture

# Limits and bounds
MAX_TOOL_CALLS=15
MAX_MODEL_CALLS=20
COST_CEILING_USD=0.25
PRICE_INPUT_PER_M=1.50
PRICE_OUTPUT_PER_M=7.50
MAX_OUTPUT_TOKENS=2048

# Rate limiting
RATE_LIMIT_RUNS=5
RATE_LIMIT_WINDOW_S=3600

# Database and file paths
CUSTOMERS_DB=data/customers.db
RUNS_DB=data/runs.db
SQL_AUDIT_PATH=audit/sql_audit.jsonl
TRACE_LOG_PATH=logs/agent_trace.jsonl

# Logging and tracing
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=dummy-langsmith-key
LANGSMITH_PROJECT=campaign-agent
